# 生产编排（绑挂版）环境变量模板：复制为 deploy/.env 后按实际值修改。
# 用法：docker compose -f deploy/docker-compose.prod-bind.yml --env-file deploy/.env up -d
# 密码里的 $ 会被 compose 展开，改用字母数字与 _-.@# 组合。

# ---- 端口与监听 ------------------------------------------------------------
# 只绑回环；公网入口由外层 nginx/负载均衡负责
BIND_ADDR=127.0.0.1
CONTROL_PORT=8460
WEB_PORT=8461

# ---- 数据目录（必须绑挂，升级/自更新时不能换路径）--------------------------
# 可以是相对路径（相对 compose 文件所在目录）或绝对路径
UNIFIED_DATA_BIND=../data

# ---- 必须显式给出的运行参数 ------------------------------------------------
UNIFIED_ADMIN_USER=admin
# 生产必须显式设置强口令；留空会随机生成并写入 <数据目录>/admin-password.txt
UNIFIED_ADMIN_PASSWORD=
# 容器内必须是 0：演示模式要求绑定回环地址，容器里起不来，且反代会让请求级 403 失效
UNIFIED_DEMO_MODE=0
# sidecar 探测超时（秒）：宿主机 sidecar 不在线时设置页每张卡的等待上限
UNIFIED_SIDECAR_PROBE_TIMEOUT=1.5

# ---- 常规项（按需覆盖）-----------------------------------------------------
UNIFIED_SESSION_TTL_SEC=86400
# 走 HTTPS 时保持 true；纯 HTTP 演练改成 false，否则登录 Cookie 不会被浏览器保存
UNIFIED_COOKIE_SECURE=true
UNIFIED_ALLOW_ANONYMOUS_GATEWAY=false
UNIFIED_ALLOW_PRIVATE_UPSTREAMS=0
UNIFIED_SSE_MAX_SECONDS=600
UNIFIED_LOG_LEVEL=info
UNIFIED_LOG_FORMAT=text
UNIFIED_ENABLE_DOCS=0
UNIFIED_UPSTREAM_MAX_CONNECTIONS=100
UNIFIED_UPSTREAM_MAX_KEEPALIVE=50
UNIFIED_FAILURE_WINDOW_SEC=60
UNIFIED_FAILURE_WINDOW_MAX=20
UNIFIED_MODELS_CACHE_TTL_SEC=60
UNIFIED_MODEL_FALLBACK_FIRST=0
# 同源部署可留空；前端独立域名访问 API 时填写，例如 https://console.example.com
UNIFIED_CORS_ORIGINS=

# ---- 宿主机 sidecar --------------------------------------------------------
CODEBUDDY_BASE=http://host.docker.internal:7864
CODEBUDDY_API_KEY=
OPENCODE_UPSTREAM_BASE=https://opencode.ai/zen
TRAE_SIDECAR_BASE=http://host.docker.internal:7871
DEEPSEEK_SIDECAR_BASE=http://host.docker.internal:5001
QODER_SIDECAR_BASE=http://host.docker.internal:7873
CODAR_SIDECAR_BASE=http://host.docker.internal:8801
