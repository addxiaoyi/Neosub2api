# 环境变量模板：复制为 deploy/.env 后按实际域名/密码修改。
# compose 会把它注入 control 容器；同目录的 .env 也用于 compose 变量插值。
# 注意：密码中的 $ 会被 compose 当作变量展开，改用字母数字与符号 _-.@# 组合。

UNIFIED_ADMIN_USER=admin
# 留空则容器首次启动随机生成，写入 /data/admin-password.txt；生产环境建议显式设置强口令
UNIFIED_ADMIN_PASSWORD=
UNIFIED_SESSION_TTL_SEC=86400
UNIFIED_COOKIE_SECURE=true
UNIFIED_ALLOW_ANONYMOUS_GATEWAY=false
UNIFIED_ALLOW_PRIVATE_UPSTREAMS=0
UNIFIED_SSE_MAX_SECONDS=600
# /v1 JSON 请求体上限（字节，默认 8 MiB）；超限 413 request_too_large，不读进内存
UNIFIED_GATEWAY_MAX_BODY_BYTES=8388608

# 失败请求限流（同一密钥滑动窗口；任一项为 0 即关闭）
UNIFIED_FAILURE_WINDOW_SEC=60
UNIFIED_FAILURE_WINDOW_MAX=20

# 上游实拉模型目录的进程内缓存（秒），0 表示关闭
UNIFIED_MODELS_CACHE_TTL_SEC=60

# 未知模型兜底：0 = 严格 404（默认），1 = 兜底到首家启用且能力位匹配的 provider
UNIFIED_MODEL_FALLBACK_FIRST=0

# 日志与上游连接池（默认值同根 .env.example）。本编排经 env_file 把 deploy/.env 整份注入容器，
# 这 5 个键在这里设了**会生效**；根 docker-compose.yml 没有 env_file，走 ${VAR:-默认值} 插值透传，
# 两边差异只是注入方式——改完都要重启 control 才生效
UNIFIED_LOG_LEVEL=info
# 访问日志格式：text = 默认，json = 单行 JSON（采集系统用）
UNIFIED_LOG_FORMAT=text
# OpenAPI 文档端点 /docs、/openapi.json、/redoc：默认关闭，生产保持关闭
UNIFIED_ENABLE_DOCS=0
# 每个上游 client 的连接池上限；并发高时调大
UNIFIED_UPSTREAM_MAX_CONNECTIONS=100
UNIFIED_UPSTREAM_MAX_KEEPALIVE=50

# 备份加密密钥（32 字节 base64，本地归档字段封装与远端上传共用）。
# 不配时本地备份会清空上游密钥字段并告警（恢复后重新粘贴），远端上传直接失败
UNIFIED_BACKUP_ENCRYPTION_KEY=

# 前后端同源（都由 nginx 出）时无需 CORS；只有前端独立域名访问 API 才需要列出来
UNIFIED_CORS_ORIGINS=https://your-domain.example

# 上游 sidecar：宿主机运行时用 host.docker.internal（compose 已加 extra_hosts）
CODEBUDDY_BASE=http://host.docker.internal:7864
CODEBUDDY_API_KEY=
OPENCODE_UPSTREAM_BASE=https://opencode.ai/zen
GROK_REGISTER_EXECUTOR_URL=
GROK_REGISTER_MAX_CONCURRENCY=2
GROK_REGISTER_MAX_WORKERS=4
GROK_REGISTER_EXECUTOR_TIMEOUT_SEC=900
GROK_REGISTER_POLL_INTERVAL_SEC=2
TRAE_SIDECAR_BASE=http://host.docker.internal:7871
# Deepseek2Go 上游默认端口 5001；若自行改 sidecar 端口需同步
DEEPSEEK_SIDECAR_BASE=http://host.docker.internal:5001
QODER_SIDECAR_BASE=http://host.docker.internal:7873
# codar2api（MIT）默认关闭：需自行 clone 上游并在宿主机启动
CODAR_SIDECAR_BASE=http://host.docker.internal:8801

# ⚠️ 不要在这里设置 UNIFIED_DEMO_MODE：演示实例只在本机用 scripts/demo.* 启动。
# 反代会把 request.client.host 变成 127.0.0.1，演示模式的请求级 403 会失效；
# 本目录的 compose 已把 UNIFIED_DEMO_MODE 强制为 0。详见 deploy/README.md。
