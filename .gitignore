*.pem
*.key
!deploy/release-pubkey.pem

# 仅在本地留存的验证截图（体积大，不随仓库分发）
docs/ux-shots/

# 日志与临时构建产物
*.log
/logs/
*.bak
.run/
*.tsbuildinfo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
coverage/
dist/
build/
.turbo/

# 编辑器
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本地临时验证产物（e2e/压测/可访问性演练的脚本、快照与报告）
tmp/

# 代码图谱索引（本地生成的分析缓存）
.codegraph/

