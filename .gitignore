# 依赖与产物
node_modules/
.next/
out/
__pycache__/
*.pyc

# 本地数据与运行时
data/
.runtime/
*.sqlite*
*.db
*.db-wal
*.db-shm

# 本地环境（含部署用 env 与证书）
.env
.env.local
.env.*.local
deploy/.env
deploy/.env*
!deploy/.env.example
!deploy/.env.prod-bind.example
deploy/certs/
deploy/certbot-webroot/

