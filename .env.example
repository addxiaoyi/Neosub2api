# 消费方：根 docker-compose.yml 的 ${VAR} 插值、scripts/start.*、scripts/demo.*（cp 为仓库根 .env）。
# 直接 python -m uvicorn 不读本文件；前端变量放 apps/web/.env（next 只认自己目录的 .env）。

# 控制面（容器内监听 8000；compose 映射到宿主机 8010，避开常见的 8000 占用）
UNIFIED_DATA_DIR=./data
UNIFIED_DB_PATH=./data/unified.db
UNIFIED_ADMIN_USER=admin
# 管理员口令：留空则首次启动随机生成并写入 data/admin-password.txt（权限 0600），日志里也会提示
# 历史默认值 unified-admin 已废弃，只用于识别旧库并自动轮换
UNIFIED_ADMIN_PASSWORD=
UNIFIED_SESSION_TTL_SEC=86400
UNIFIED_COOKIE_SECURE=false
UNIFIED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 代码默认值；根 compose 未设置本键时用 :8080。前端经 nginx 同源反代时无需跨域，一般不用改
UNIFIED_WEB_DIR=./apps/web/out

# 控制面监听：默认只绑本机；确实需要外部访问再改成 0.0.0.0（并配 TLS）
UNIFIED_HOST=127.0.0.1
UNIFIED_PORT=8010

# 宿主端口绑定：只被根 docker-compose.yml 的端口映射插值使用，控制面进程不读它
UNIFIED_BIND_HOST=127.0.0.1

# 上游地址守卫：默认拒绝环回/私网/链路本地；内网 sidecar 场景显式置 1
UNIFIED_ALLOW_PRIVATE_UPSTREAMS=0

# 流式响应单请求最大时长（秒），防止上游长流长期占用连接
UNIFIED_SSE_MAX_SECONDS=600

# 网关鉴权：M2 默认拒绝匿名调用 /v1；管理员密钥在前端「密钥」页创建
UNIFIED_ALLOW_ANONYMOUS_GATEWAY=false

# 失败请求限流（只拦刷失败请求，不影响成功请求的计费与额度）
# 对同一密钥做滑动窗口计数，计数直接来自 request_logs（status>=400 或 error 非空）；
# 窗内失败次数达到上限后返回 429（type=failure_rate_limited，带 Retry-After）
# UNIFIED_FAILURE_WINDOW_SEC 窗口长度（秒），UNIFIED_FAILURE_WINDOW_MAX 窗口内失败上限
# 任一项设为 0 即关闭该限流
UNIFIED_FAILURE_WINDOW_SEC=60
UNIFIED_FAILURE_WINDOW_MAX=20

# 上游实拉模型目录的进程内缓存（秒）：默认 60；设为 0 关闭缓存。
# 缓存键含 provider、base_url 与凭据指纹，切换地址或凭据后立即失效。
UNIFIED_MODELS_CACHE_TTL_SEC=60

# 未知模型名兜底（默认关）：
#   0 = 返回 404 model_not_found（严格模式，当前默认）
#   1 = 兜底到首家启用的、且支持当前端点能力位的 provider（恢复旧行为，给存量客户端留逃生口）
# 只影响「一家都没命中」；同名模型在多家命中时仍然是 400 ambiguous_model，不受此开关影响。
UNIFIED_MODEL_FALLBACK_FIRST=0

# CodeBuddy 管理端（sidecar 未启动时该 provider 显示不可达，不假装成功）
CODEBUDDY_BASE=http://127.0.0.1:7864
CODEBUDDY_API_KEY=

# OpenCode Zen/Go 直连上游（opencode 已为主仓内置实现，不再需要 opencode2api 进程）
OPENCODE_UPSTREAM_BASE=https://opencode.ai/zen

# Grok 注册任务执行器（外部浏览器运行时 HTTP 入口；留空则任务明确失败，不伪造成功）
GROK_REGISTER_EXECUTOR_URL=
GROK_REGISTER_MAX_CONCURRENCY=2
GROK_REGISTER_MAX_WORKERS=4

# 三家新增 sidecar（未启动则对应 provider 显示不可达）
TRAE_SIDECAR_BASE=http://127.0.0.1:7871
# Deepseek2Go 上游默认端口 5001（见其 cmd/server/main.go 的 PORT）；若自行改 sidecar 端口需同步此处
DEEPSEEK_SIDECAR_BASE=http://127.0.0.1:5001
QODER_SIDECAR_BASE=http://127.0.0.1:7873

# codar2api sidecar（MIT）默认关闭：上游不在主仓内，需自行 clone 并启动（默认 127.0.0.1:8801）
# 未启动时该 provider 显示不可达，不会假装成功
CODAR_SIDECAR_BASE=http://127.0.0.1:8801

# ── 以下 5 个键代码会读；根 docker-compose.yml 以 ${VAR:-默认值} 插值透传给容器，
#    deploy/ 编排则经 env_file 把 deploy/.env 整份注入 ──

# uvicorn 启动日志级别（仅 python -m app.main 入口读取，uvicorn CLI 启动时忽略）
UNIFIED_LOG_LEVEL=info
# 访问日志格式：text = 默认可读文本，json = 单行 JSON（采集系统用）
UNIFIED_LOG_FORMAT=text
# OpenAPI 文档端点 /docs、/openapi.json、/redoc：默认关闭，生产保持关闭
UNIFIED_ENABLE_DOCS=0
# 每个上游 client 的连接池上限；并发高时调大
UNIFIED_UPSTREAM_MAX_CONNECTIONS=100
UNIFIED_UPSTREAM_MAX_KEEPALIVE=50

# 不要在本文件设 UNIFIED_DEMO_MODE=1：本机演示用 scripts/demo.*，三份 compose 强制为 0

# ── 在线更新（默认全部关闭：不开开关不发任何探测请求，现有部署行为不变）──
# 总开关；只有开启后 /api/system/update-status 才会真的去拉发布源
UNIFIED_UPDATE_ENABLED=false
# 发布源 manifest 的 HTTPS 地址；同目录约定放 release-manifest.json.sig 与 release.zip
# 例：https://github.com/<owner>/<repo>/releases/latest/download/release-manifest.json
UNIFIED_UPDATE_MANIFEST_URL=
# 仓库内固定的验签公钥（相对路径按仓库根解析）。manifest 自带的公钥一律不认
UNIFIED_UPDATE_PUBKEY=deploy/release-pubkey.pem
# 检测结果缓存秒数；默认 6 小时，避免每次打开面板都打发布源
UNIFIED_UPDATE_CHECK_TTL_SEC=21600
# 发布包与解压后总字节上限（默认 256 MiB）
UNIFIED_UPDATE_MAX_BYTES=268435456
# 裸机部署的服务名：Windows 走 sc stop/start，Linux 走 systemctl restart；
# 容器内不需要它（由 restart: unless-stopped 拉起）。留空且不在容器内 = can_apply=false
UNIFIED_SERVICE_NAME=

